{
  "name": "@effect-verifier/schema",
  "version": "0.1.0",
  "description": "Effect Schema input support for @effect-verifier: lowers a supported Schema subset into verifier constraints.",
  "keywords": [
    "effect",
    "effect-schema",
    "smt",
    "typescript",
    "verification",
    "z3"
  ],
  "homepage": "https://github.com/jbt95/effect-verify#readme",
  "bugs": {
    "url": "https://github.com/jbt95/effect-verify/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jordi Bermejo Tornero",
    "url": "https://github.com/jbt95"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbt95/effect-verify.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {

{
  "name": "@effect-verifier/cli",
  "version": "0.1.0",
  "description": "Command-line interface for @effect-verifier: verifies symbolic and source proofs against Z3.",
  "keywords": [
    "cli",
    "effect",
    "smt",
    "typescript",
    "verification",
    "z3"
  ],
  "homepage": "https://github.com/jbt95/effect-verify#readme",
  "bugs": {
    "url": "https://github.com/jbt95/effect-verify/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jordi Bermejo Tornero",
    "url": "https://github.com/jbt95"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbt95/effect-verify.git"
  },
  "bin": {
    "effect-verify": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@effect-verifier/core": "workspace:*",
    "@effect-verifier/schema": "workspace:*",
    "@effect-verifier/typescript": "workspace:*",
    "@effect-verifier/z3": "workspace:*",
    "effect": "3.22.2",
    "z3-solver": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
